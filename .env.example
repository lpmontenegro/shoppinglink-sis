# Database — get this from Railway after creating the PostgreSQL service
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth — generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Your production URL — update after domain is connected
NEXTAUTH_URL="https://shoppinglink.net"

# Cloudinary — used to store product/offer photos taken from the phone
# (camera or gallery). Get these from your Cloudinary dashboard after
# creating a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
