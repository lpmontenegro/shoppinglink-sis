generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── MASTER DATA ─────────────────────────────────────────────────────────────

model Client {
  id                String            @id @default(cuid())
  fullName          String
  phones            String[]
  deliveryAddress   String
  zone              String
  fulfillmentMethod FulfillmentMethod @default(DELIVERY)
  pickupPlaceId     String?
  notes             String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  pickupPlace      PickupPlace?      @relation(fields: [pickupPlaceId], references: [id])
  orders           Order[]
  statements       ClientStatement[]
  storeOrderClaims StoreOrderClaim[]
}

enum FulfillmentMethod {
  PICKUP    // el cliente recoge en un punto fijo
  DELIVERY  // se le entrega por zona
}

// Puntos de recolección en Guatemala (ej. oficina, casa de una encargada de
// zona) donde los clientes con fulfillmentMethod = PICKUP recogen su pedido.
// Se reutilizan entre ciclos, por eso son tabla maestra aparte.
model PickupPlace {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  responsible String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients Client[]
}

// ─── CYCLES ──────────────────────────────────────────────────────────────────

model Cycle {
  id               String      @id @default(cuid())
  code             String      @unique
  status           CycleStatus @default(OPEN)
  openDate         DateTime
  closeDate        DateTime?
  travelDepartDate DateTime?
  travelReturnDate DateTime?
  boxArrivalDate   DateTime? // llegada de la caja de courier/online (la maleta la traen las dueñas al regresar del viaje, ver travelReturnDate)
  usAddressId      String? // dirección en USA donde se reciben los paquetes online/courier este ciclo
  taxRate          Decimal     @db.Decimal(5, 2) @default(7.5) // impuesto de compra en USA (%), varía según el estado de usAddress; 7.5% de default
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  usAddress  UsAddress?        @relation(fields: [usAddressId], references: [id])
  orders     Order[]
  expenses   CycleExpense[]
  storeOrders StoreOrder[]
  statements ClientStatement[]
}

// Direcciones de recepción en USA, reutilizables entre ciclos (bodega propia,
// dirección de un contacto, etc.) — evita re-escribir la misma dirección cada
// ciclo.
model UsAddress {
  id          String   @id @default(cuid())
  name        String // nombre corto para identificarla en el combo, ej. "Bodega Miami"
  description String?
  addressLine String
  city        String
  state       String
  zip         String
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycles Cycle[]
}

enum CycleStatus {
  OPEN            // recibiendo pedidos
  ORDERS_CLOSED   // cerrado a nuevos pedidos, preparando viaje
  TRAVELING       // viaje en curso / compras en tienda
  PACKING         // clasificando maleta/caja, armando listas de distribución
  DELIVERING      // entregando a clientes
  DONE            // cerrado, estados de cuenta liquidados
}

model CycleExpense {
  id          String   @id @default(cuid())
  cycleId     String
  type        String   // boletos aéreos, maletas, cajas, gastos de viaje, otros
  date        DateTime
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle Cycle @relation(fields: [cycleId], references: [id])
}

// ─── ORDERS (compras anticipadas y directas/courier) ─────────────────────────

// Un pedido (lo que llega de un cliente en una conversación/ask de WhatsApp)
// es un contenedor de cliente+ciclo; puede traer varios productos (items),
// cada uno con su propio costo, precio y estado — así un solo pedido agrupa
// todo lo que ese cliente pidió junto, en vez de crear una fila separada por
// producto.
model Order {
  id           String      @id @default(cuid())
  clientId     String
  cycleId      String
  orderDate    DateTime    @default(now())
  exchangeRate Decimal     @db.Decimal(10, 4) // tipo de cambio USD->GTQ vigente al crear el pedido (snapshot histórico), aplica a los items ADVANCE
  source       OrderSource @default(MANUAL)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  cycle  Cycle       @relation(fields: [cycleId], references: [id])
  items  OrderItem[]
}

// Un producto dentro de un pedido. El estado (confirmado/empacado/entregado/
// cancelado) es por producto, no por pedido completo, porque productos del
// mismo pedido pueden llegar o procesarse por separado.
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productLink    String?
  purchaseType   PurchaseType
  costUsd        Decimal?       @db.Decimal(10, 2) // costo en USD tal como se compra (solo aplica a ADVANCE; tiendas/online cobran en $)
  cost           Decimal        @db.Decimal(10, 2) // costo en quetzales: costUsd * exchangeRate del pedido (ADVANCE) o costo directo en Q (COURIER)
  salePrice      Decimal        @db.Decimal(10, 2) // precio cobrado al cliente, siempre en quetzales
  confirmed      Boolean        @default(false)
  packed         Boolean        @default(false)
  packedIn       PackingMethod?
  delivered      Boolean        @default(false)
  deliveryDate   DateTime?
  canceled       Boolean        @default(false)
  canceledReason String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order   Order         @relation(fields: [orderId], references: [id])
  product OrderProduct?
}

// Detalle físico de un producto de pedido: foto (para reconocimiento de
// imagen en fase 2), confirmación de recepción y forma de importación.
model OrderProduct {
  id                String    @id @default(cuid())
  orderItemId       String    @unique
  photoUrl          String?
  receivedConfirmed Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

enum PurchaseType {
  ADVANCE  // compra anticipada (Shopping Link compra)
  COURIER  // compra directa: cliente ya compró, solo se cobra traída
}

enum PackingMethod {
  SUITCASE // maleta
  BOX      // caja
}

enum OrderSource {
  MANUAL
  WHATSAPP
}

// ─── STORE PURCHASES (compras en tiendas durante el viaje) ───────────────────

model StoreOrder {
  id             String   @id @default(cuid())
  cycleId        String
  photoUrl       String?
  productName    String
  store          String
  cost           Decimal  @db.Decimal(10, 2)
  suggestedPrice Decimal  @db.Decimal(10, 2)
  finalPrice     Decimal  @db.Decimal(10, 2)
  storeLocationNote String?
  purchased      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle  Cycle              @relation(fields: [cycleId], references: [id])
  claims StoreOrderClaim[]
}

// Un cliente reclamando unidades de un StoreOrder publicado en el grupo.
model StoreOrderClaim {
  id           String   @id @default(cuid())
  storeOrderId String
  clientId     String
  quantity     Int      @default(1)
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeOrder StoreOrder @relation(fields: [storeOrderId], references: [id])
  client     Client     @relation(fields: [clientId], references: [id])

  @@unique([storeOrderId, clientId])
}

// ─── FINANCIALS ──────────────────────────────────────────────────────────────

model ClientStatement {
  id          String   @id @default(cuid())
  clientId    String
  cycleId     String
  totalAmount Decimal  @db.Decimal(10, 2) @default(0)
  totalPaid   Decimal  @db.Decimal(10, 2) @default(0)
  balance     Decimal  @db.Decimal(10, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  cycle    Cycle     @relation(fields: [cycleId], references: [id])
  payments Payment[]

  @@unique([clientId, cycleId])
}

model Payment {
  id          String   @id @default(cuid())
  statementId String
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())

  statement ClientStatement @relation(fields: [statementId], references: [id])
}

// ─── SYSTEM SETTINGS ─────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
