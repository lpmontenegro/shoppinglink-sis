generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── MASTER DATA ─────────────────────────────────────────────────────────────

model Client {
  id                String            @id @default(cuid())
  fullName          String
  phones            String[]
  deliveryAddress   String
  zone              String
  fulfillmentMethod FulfillmentMethod @default(DELIVERY)
  pickupPlaceId     String?
  notes             String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  pickupPlace          PickupPlace?           @relation(fields: [pickupPlaceId], references: [id])
  orders               Order[]
  statements           ClientStatement[]
  storeOfferSelections StoreOfferSelection[]
}

enum FulfillmentMethod {
  PICKUP    // el cliente recoge en un punto fijo
  DELIVERY  // se le entrega por zona
}

// Puntos de recolección en Guatemala (ej. oficina, casa de una encargada de
// zona) donde los clientes con fulfillmentMethod = PICKUP recogen su pedido.
// Se reutilizan entre ciclos, por eso son tabla maestra aparte.
model PickupPlace {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  responsible String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients Client[]
}

// ─── CYCLES ──────────────────────────────────────────────────────────────────

model Cycle {
  id               String      @id @default(cuid())
  code             String      @unique
  status           CycleStatus @default(OPEN)
  openDate         DateTime
  closeDate        DateTime?
  travelDepartDate DateTime?
  travelReturnDate DateTime?
  boxArrivalDate   DateTime? // llegada de la caja de courier/online (la maleta la traen las dueñas al regresar del viaje, ver travelReturnDate)
  usAddressId      String? // dirección en USA donde se reciben los paquetes online/courier este ciclo
  taxRate          Decimal     @db.Decimal(5, 2) @default(7.5) // impuesto de compra en USA (%), varía según el estado de usAddress; 7.5% de default
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  usAddress   UsAddress?        @relation(fields: [usAddressId], references: [id])
  orders      Order[]
  expenses    CycleExpense[]
  storeVisits StoreVisit[]
  statements  ClientStatement[]
}

// Direcciones de recepción en USA, reutilizables entre ciclos (bodega propia,
// dirección de un contacto, etc.) — evita re-escribir la misma dirección cada
// ciclo.
model UsAddress {
  id          String   @id @default(cuid())
  name        String // nombre corto para identificarla en el combo, ej. "Bodega Miami"
  description String?
  addressLine String
  city        String
  state       String
  zip         String
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycles Cycle[]
}

enum CycleStatus {
  OPEN            // recibiendo pedidos
  ORDERS_CLOSED   // cerrado a nuevos pedidos, preparando viaje
  TRAVELING       // viaje en curso / compras en tienda
  PACKING         // clasificando maleta/caja, armando listas de distribución
  DELIVERING      // entregando a clientes
  DONE            // cerrado, estados de cuenta liquidados
}

model CycleExpense {
  id          String   @id @default(cuid())
  cycleId     String
  type        String   // boletos aéreos, maletas, cajas, gastos de viaje, otros
  date        DateTime
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle Cycle @relation(fields: [cycleId], references: [id])
}

// ─── ORDERS (compras anticipadas y directas/courier) ─────────────────────────

// Un pedido (lo que llega de un cliente en una conversación/ask de WhatsApp)
// es un contenedor de cliente+ciclo; puede traer varios productos (items),
// cada uno con su propio costo, precio y estado — así un solo pedido agrupa
// todo lo que ese cliente pidió junto, en vez de crear una fila separada por
// producto.
model Order {
  id           String      @id @default(cuid())
  clientId     String
  cycleId      String
  orderDate    DateTime    @default(now())
  exchangeRate Decimal     @db.Decimal(10, 4) // tipo de cambio USD->GTQ vigente al crear el pedido (snapshot histórico), aplica a los items ADVANCE
  source       OrderSource @default(MANUAL)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  cycle  Cycle       @relation(fields: [cycleId], references: [id])
  items  OrderItem[]
}

// Un producto dentro de un pedido. El estado (confirmado/empacado/entregado/
// cancelado) es por producto, no por pedido completo, porque productos del
// mismo pedido pueden llegar o procesarse por separado.
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productName    String? // nombre corto para mostrar en listas (empaque/distribución); a futuro se puede autocompletar desde Amazon/tienda
  photoUrl       String? // link a foto del producto, para identificarlo fácil al empacar/organizar
  productLink    String?
  purchaseType   PurchaseType
  quantity       Int            @default(1) // cuántas unidades idénticas de este producto — costUsd/cost/salePrice son SIEMPRE por unidad, el total se calcula como precio × quantity
  costUsd        Decimal?       @db.Decimal(10, 2) // costo en USD tal como se compra, por unidad (solo aplica a ADVANCE; tiendas/online cobran en $)
  cost           Decimal        @db.Decimal(10, 2) // costo en quetzales por unidad: costUsd * exchangeRate del pedido (ADVANCE) o costo directo en Q (COURIER)
  salePrice      Decimal        @db.Decimal(10, 2) // precio cobrado al cliente por unidad, siempre en quetzales
  confirmed      Boolean        @default(false)
  packed         Boolean        @default(false)
  packedIn       PackingMethod?
  delivered      Boolean        @default(false)
  deliveryDate   DateTime?
  canceled       Boolean        @default(false)
  canceledReason String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order                Order                 @relation(fields: [orderId], references: [id])
  product              OrderProduct?
  storeOfferSelection  StoreOfferSelection?
}

// Detalle físico de un producto de pedido: foto (para reconocimiento de
// imagen en fase 2), confirmación de recepción y forma de importación.
model OrderProduct {
  id                String    @id @default(cuid())
  orderItemId       String    @unique
  photoUrl          String?
  receivedConfirmed Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

enum PurchaseType {
  ADVANCE  // compra anticipada (Shopping Link compra)
  COURIER  // compra directa: cliente ya compró, solo se cobra traída
}

enum PackingMethod {
  SUITCASE // maleta
  BOX      // caja
}

enum OrderSource {
  MANUAL
  WHATSAPP
}

// ─── COMPRAS EN TIENDA (proceso de 2 pasos, durante el viaje) ────────────────
//
// Paso 1 — Oferta: en cada visita a una tienda (StoreVisit) se registran los
// productos encontrados (StoreOfferItem) con foto y precio sugerido; al
// "publicar" la visita, esa lista se comparte manualmente por WhatsApp.
// Paso 2 — Selección/compra: los clientes piden cuáles quieren
// (StoreOfferSelection); cada selección genera al instante un OrderItem real
// dentro del pedido de ese cliente en el ciclo (aparece en Pedidos/Empaque/
// Distribución igual que cualquier otro producto), y a la vez cuenta como
// "carrito" de lo que hay que comprar en esa tienda (suma de selections por
// StoreOfferItem). Al comprar de verdad, se marca el StoreOfferItem como
// purchased, lo que confirma automáticamente los OrderItem relacionados.

model StoreVisit {
  id        String           @id @default(cuid())
  cycleId   String
  store     String
  visitDate DateTime         @default(now())
  status    StoreVisitStatus @default(DRAFT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  cycle  Cycle            @relation(fields: [cycleId], references: [id])
  offers StoreOfferItem[]
}

enum StoreVisitStatus {
  DRAFT     // armando la oferta, todavía no se comparte con clientes
  PUBLISHED // publicada (se comparte por WhatsApp), tomando selecciones de clientes
  DONE      // compra en tienda terminada, visita cerrada
}

// Un producto encontrado en la tienda durante la visita, con su precio
// sugerido calculado igual que en Pedidos (costo + impuesto del ciclo +
// ganancia escalonada).
model StoreOfferItem {
  id             String   @id @default(cuid())
  storeVisitId   String
  photoUrl       String?
  productName    String
  costUsd        Decimal  @db.Decimal(10, 2)
  exchangeRate   Decimal  @db.Decimal(10, 4) // tipo de cambio vigente al registrar el producto (snapshot histórico)
  cost           Decimal  @db.Decimal(10, 2) // costo en quetzales: costUsd * exchangeRate
  suggestedPrice Decimal  @db.Decimal(10, 2) // precio sugerido en Q
  finalPrice     Decimal  @db.Decimal(10, 2) // precio ofrecido/cobrado a los clientes, en Q (editable, default = sugerido)
  purchased      Boolean  @default(false) // ya se compró en tienda la cantidad total pedida
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  storeVisit StoreVisit             @relation(fields: [storeVisitId], references: [id])
  selections StoreOfferSelection[]
}

// Un cliente pidiendo cantidad de un producto ofrecido. Al crearse genera un
// OrderItem real (orderItemId) en el pedido de ese cliente para ese ciclo.
model StoreOfferSelection {
  id          String   @id @default(cuid())
  offerItemId String
  clientId    String
  quantity    Int      @default(1)
  orderItemId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerItem StoreOfferItem @relation(fields: [offerItemId], references: [id])
  client    Client         @relation(fields: [clientId], references: [id])
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id])

  @@unique([offerItemId, clientId])
}

// ─── FINANCIALS ──────────────────────────────────────────────────────────────

model ClientStatement {
  id          String   @id @default(cuid())
  clientId    String
  cycleId     String
  totalAmount Decimal  @db.Decimal(10, 2) @default(0)
  totalPaid   Decimal  @db.Decimal(10, 2) @default(0)
  balance     Decimal  @db.Decimal(10, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  cycle    Cycle     @relation(fields: [cycleId], references: [id])
  payments Payment[]

  @@unique([clientId, cycleId])
}

model Payment {
  id          String   @id @default(cuid())
  statementId String
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())

  statement ClientStatement @relation(fields: [statementId], references: [id])
}

// ─── SYSTEM SETTINGS ─────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
